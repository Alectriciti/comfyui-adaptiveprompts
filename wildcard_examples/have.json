{
    "displayname": "Utility: Have",
    "color": "#84a4f0",
    "description": "Converts \"He\"/\"She\" into `has`, and \"They\" into `have` respectively",
    "notes": "He `has`\nShe `has`\nThey `have`",
    "variables": {},
    "loras": [],
    "generate": [
        {
            "output": "has",
            "chance": 1000,
            "if": "gender == male || gender == female"
        },
        {
            "output": "have",
            "chance": 0.01
        }
    ]
}