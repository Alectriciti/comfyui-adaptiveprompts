{
    "displayname": "Template",
    "color": "#f2f2f2",
    "description": "A template for `character`",
    "variables": {
        "state": {
            "label": "#ffffff",
            "local": true,
            "quantity": 1,
            "choices": [
                {
                    "output": "## this can be thought of as a master \"mode\" selector for what kind of variables will be chosen ##\ncasual",
                    "chance": 2
                },
                {
                    "output": "combat"
                },
                {
                    "output": "professional"
                }
            ]
        },
        "series": {
            "label": "#ff6b6b",
            "quantity": 1,
            "choices": [
                {
                    "output": ""
                }
            ]
        },
        "theme": {
            "label": "#df8c9c",
            "quantity": 1,
            "choices": [
                {
                    "output": ""
                }
            ]
        },
        "name": {
            "label": "#ffda6a",
            "quantity": 1,
            "choices": [
                {
                    "output": "__name__"
                }
            ]
        },
        "namefull": {
            "label": "#ffda6a",
            "quantity": 1,
            "choices": [
                {
                    "output": "__^name__ \\(__^series__\\)"
                }
            ]
        },
        "has": {
            "label": "#a3bdd4",
            "quantity": "*",
            "choices": [
                {
                    "output": "glasses",
                    "if": "state == professional"
                }
            ]
        },
        "heritage": {
            "label": "#e7944a",
            "quantity": 1,
            "choices": [
                {
                    "output": ""
                }
            ]
        },
        "gender": {
            "label": "#6cda5c",
            "quantity": 1,
            "choices": [
                {
                    "output": "female"
                }
            ]
        },
        "profession": {
            "label": "#f25e46",
            "quantity": 1,
            "choices": [
                {
                    "output": "angel medic\nguardian angel",
                    "chance": 2.5
                },
                {
                    "output": "{1-2$$ $$angelic|field|combat} medic"
                }
            ]
        },
        "personality": {
            "label": "#e085e7",
            "quantity": "*",
            "choices": [
                {
                    "output": "confident"
                },
                {
                    "output": "compassionate"
                },
                {
                    "output": "kind"
                },
                {
                    "output": "heroic"
                },
                {
                    "output": "graceful"
                }
            ]
        },
        "color": {
            "label": "#dd61e1",
            "quantity": "1-2",
            "choices": [
                {
                    "output": "## this will be used as a generic color palette. In this case, 1 to 2 values will be set to __^color__ ##\nwhite"
                },
                {
                    "output": "## only one of these will be picked exclusively, never both##\ngold%2\nyellow\nred%0.5\npink%0.2"
                }
            ]
        },
        "eyecolor": {
            "label": "#3cc1ff",
            "quantity": 1,
            "choices": [
                {
                    "output": "blue\n{sky|light} blue"
                }
            ]
        },
        "haircolor": {
            "label": "#c2743b",
            "quantity": 1,
            "choices": [
                {
                    "output": "blonde",
                    "chance": 1
                },
                {
                    "output": "light blonde",
                    "chance": 0.75
                },
                {
                    "output": "white",
                    "chance": 0.25
                }
            ]
        },
        "clothes": {
            "label": "#71df82",
            "quantity": "1-3",
            "choices": [
                {
                    "output": "a __^color__ shirt"
                },
                {
                    "output": "a __^color__ {shirt|blouse|top}",
                    "if": "state == casual"
                },
                {
                    "output": "{casual|jean} {pants|shorts}",
                    "if": "state == casual"
                }
            ]
        }
    },
    "loras": [],
    "generate": [
        {
            "output": "__generate_character__ ## <-- This is a generic character template, it will utilize some of the variables we set here, but may not be as tailored ##",
            "chance": 1
        }
    ]
}