{
    "displayname": "Utility: Their",
    "color": "#84a4f0",
    "description": "Converts gender into `his`, `her`, or `their`",
    "notes": "He `his`\nShe `her`\nThey `their`",
    "variables": {},
    "loras": [],
    "generate": [
        {
            "output": "his",
            "chance": 1000,
